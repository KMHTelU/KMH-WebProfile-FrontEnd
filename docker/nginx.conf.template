server {
    listen      80;
    listen      [::]:80;
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    # Container ini berada di belakang reverse proxy VPS, jadi redirect
    # jangan memakai host/port internal.
    absolute_redirect off;

    # Panel admin mengunggah foto anggota, ikon divisi, banner, dan media
    # lewat multipart. Default nginx 1m terlalu kecil untuk foto dari kamera HP.
    client_max_body_size 25m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip            on;
    gzip_vary       on;
    gzip_proxied    any;
    gzip_min_length 1024;
    gzip_types      text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml font/woff font/woff2;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Nama file aset hasil build Vite mengandung hash, jadi aman di-cache lama.
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location = /index.html {
        expires -1;
    }

    # Diteruskan ke backend supaya frontend cukup memakai VITE_API_BASE_URL=/api
    # dan tidak perlu konfigurasi CORS.
    location /api/ {
        proxy_pass            ${API_PROXY_TARGET};
        proxy_http_version    1.1;
        proxy_ssl_server_name on;
        proxy_set_header      X-Real-IP $remote_addr;
        proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header      X-Forwarded-Proto $scheme;
        proxy_read_timeout    60s;
        # Upload besar diteruskan apa adanya, tidak ditahan di buffer dulu.
        proxy_request_buffering off;
    }

    location /docs {
        proxy_pass            ${API_PROXY_TARGET};
        proxy_http_version    1.1;
        proxy_ssl_server_name on;
        proxy_set_header      X-Real-IP $remote_addr;
        proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header      X-Forwarded-Proto $scheme;
    }

    # Aplikasi memakai createBrowserRouter, jadi semua rute non-file
    # harus dilayani index.html agar refresh/deep link tidak 404.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
