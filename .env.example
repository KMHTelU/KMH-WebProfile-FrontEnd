# Base URL yang dipakai axios di sisi klien.
# Default "/api" -> di-proxy oleh Vite dev server ke VITE_API_PROXY_TARGET (menghindari CORS saat dev).
# Untuk build production, isi dengan URL API penuh, mis: https://kmh.leviathanbolu.my.id/api
VITE_API_BASE_URL=

# Target proxy dev server (hanya dipakai saat `npm run dev`).
VITE_API_PROXY_TARGET=

# Fallback konten statis saat API kosong (true/false).
VITE_ENABLE_STATIC_FALLBACK=

# ID profil organisasi untuk halaman About (backend hanya punya GET /:id).
VITE_ORG_PROFILE_ID=

# Tampilkan tombol Login admin di navbar (true/false).
VITE_SHOW_ADMIN_LOGIN=

# URL publik situs untuk canonical & Open Graph/Twitter.
# Domain frontend, bukan domain API.
VITE_SITE_URL=

# --- Khusus deployment Docker (dibaca oleh docker-compose.yml) ---

# Port di host yang dipetakan ke port 80 container.
APP_PORT=

# Tujuan proxy /api dan /docs pada nginx di dalam container.
# Isi dengan URL backend, tanpa trailing slash.
API_PROXY_TARGET=
