# Base URL yang dipakai axios di sisi klien.
# Default "/api" -> di-proxy oleh Vite dev server ke VITE_API_PROXY_TARGET (menghindari CORS saat dev).
# Untuk build production, isi dengan URL API penuh, mis: https://kmh.leviathanbolu.my.id/api
VITE_API_BASE_URL=/api

# Target proxy dev server (hanya dipakai saat `npm run dev`).
VITE_API_PROXY_TARGET=https://kmh.leviathanbolu.my.id

# Jika true, halaman publik akan memakai konten statis (kmh-data.ts) sebagai fallback
# ketika endpoint API mengembalikan data kosong. Set "false" untuk murni menampilkan data API.
VITE_ENABLE_STATIC_FALLBACK=true

# ID profil organisasi yang akan ditampilkan di halaman publik.
VITE_ORG_PROFILE_ID=31ef793f-80fb-4e3d-95b7-39438bff5773

# Jika true, button login di navbar akan ditampilkan.
VITE_SHOW_ADMIN_LOGIN=true

# URL publik situs (dipakai untuk canonical & Open Graph/Twitter Card).
# Ganti dengan domain produksi frontend kamu saat sudah live.
VITE_SITE_URL=https://kmh.leviathanbolu.my.id